{
  "name": "octacel-example-supabase-postgres",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "format:check": "prettier --check src scripts tests *.mjs *.json",
    "lint": "eslint src scripts tests *.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "db:migrate:test": "node scripts/apply-migrations.mjs",
    "db:schema:check": "node scripts/check-schema.mjs",
    "test:rls": "node --test tests/rls.test.mjs",
    "test:tenant-isolation": "node --test tests/tenant-isolation.test.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
