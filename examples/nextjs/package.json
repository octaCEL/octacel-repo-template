{
  "name": "octacel-example-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "format:check": "prettier --check app src tests *.mjs *.json",
    "lint": "eslint app src tests *.mjs",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
