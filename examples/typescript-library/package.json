{
  "name": "@octacel/example-library",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "format:check": "prettier --check src tests *.mjs *.json",
    "lint": "eslint src tests *.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.9.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
